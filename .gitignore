# Installed dependencies generated during local research
node_modules/
.eggs/

# Audit tables and logs are part of the research evidence
!audit/**/*.csv

# Raw Drive pages embed application keys; retain parsed listings instead.
/audit/results_review/drive_folder.html
/audit/results_review/drive/*.html

# Local worktrees, pull recovery copies, and SSH host records
/.worktrees/
/pull-backup-*/
/audit/ssh_known_hosts

# Disposable PDF build previews and compiler output; preserve rebuild sources.
/tmp/pdfs/synthetic_benchmark/*
!/tmp/pdfs/synthetic_benchmark/build_report.py
!/tmp/pdfs/synthetic_benchmark/report_template.tex
/tmp/pdfs/statistical_review_20261006/

# Data bundled with the standalone benchmark report.
!output/pdf/synthetic_benchmark/data/*.csv

# Redundant transfer archive; the extracted audit snapshot remains tracked.
/audit/statistical_328_20261010/remote_snapshot.zip

# Organized research artifacts and local execution environment. Dataset folders
# track only force-added lightweight evidence (scores, histories, manifests and
# reports); generators, weights, labelers and predictions stay outside Git.
/.venv/
/adult/
/california_housing/
/census_kdd/
/covertype/
/credit/
/mnist12/
/mnist28/
/news/
!/comparisons/**/*.csv
!/scripts/checkpoint_recovery/*.csv
/output/*
!/output/statistical_anova_gdrive_20261019/
!/output/statistical_anova_gdrive_20261019/**/*.csv

# Office lock files
~$*
